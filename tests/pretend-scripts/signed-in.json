{
  "agent": {
    "name": "pretend",
    "title": "Pretend assistant",
    "version": "1"
  },
  "signedIn": true,
  "authMethods": [],
  "modes": {
    "currentModeId": "act-freely",
    "availableModes": [
      {
        "id": "act-freely",
        "name": "Act freely"
      },
      {
        "id": "ask-first",
        "name": "Ask first"
      }
    ]
  },
  "turns": [
    {
      "expectPrompt": "settings skill that may fit this question: look.",
      "steps": [
        {
          "say": "I'll open the look skill first."
        }
      ]
    },
    {
      "expectPrompt": "drive",
      "steps": [
        {"say": "I'll check the drive list, then explain what it shows."},
        {"tool": {"toolCallId": "look-drive", "title": "List drives", "kind": "execute", "status": "completed"}},
        {"say": "The drive is visible. I'll do one more check."},
        {"tool": {"toolCallId": "look-mount", "title": "Read mounts", "kind": "read", "status": "completed"}},
        {"say": "Your drive is mounted read-only.\n\n1. Shut Windows down fully.\n2. Try the drive here again."}
      ]
    },
    {
      "expectPrompt": "Wi-Fi",
      "steps": [
        {
          "think": "The person wants Wi-Fi."
        },
        {
          "tool": {
            "toolCallId": "look-1",
            "title": "Read network settings",
            "kind": "read",
            "status": "completed"
          }
        },
        {
          "say": "You connect from the network icon at the bottom right.\n\n"
        },
        {
          "wait": 200
        },
        {
          "say": "1. Tap the **network** icon.\n2. Choose your network.\n"
        },
        {
          "say": "3. Type its password when the `system` asks.\n\nThat is all."
        }
      ]
    },
    {
      "expectPrompt": "printer",
      "steps": [
        {
          "say": "1. Open System Settings.\n2. Choose Printers.\n\nThat should find it.\n\nIf not, ask me again."
        }
      ]
    },
    {
      "expectPrompt": "bigger",
      "steps": [
        {
          "say": "Scaling to 125% makes everything bigger on this screen."
        },
        {
          "tool": {
            "toolCallId": "change-1",
            "title": "Run kscreen-doctor",
            "kind": "execute",
            "status": "pending",
            "rawInput": {
              "command": "sudo kscreen-doctor output.1.scale.1.25"
            }
          }
        },
        {
          "ask": {
            "toolCall": {
              "toolCallId": "change-1"
            },
            "options": [
              {
                "optionId": "yes",
                "name": "Allow",
                "kind": "allow_once"
              },
              {
                "optionId": "always",
                "name": "Always allow",
                "kind": "allow_always"
              },
              {
                "optionId": "no",
                "name": "Reject",
                "kind": "reject_once"
              }
            ]
          },
          "expect": "reject_once"
        },
        {
          "update": {
            "toolCallId": "change-1",
            "status": "failed"
          }
        },
        {
          "say": "\n\nI wasn't allowed to change it."
        }
      ]
    },
    {
      "expectPrompt": "how to do that myself",
      "steps": [
        {
          "say": "You can change it in System Settings.\n\n1. Open System Settings.\n2. Choose Display.\n3. Set Scale to 125%."
        }
      ]
    },
    {
      "expectPrompt": "infected",
      "steps": [
        {
          "say": "That window is almost certainly a scam. Your computer is not infected.\n\n1. Don't call any number it shows, and don't click anything in it.\n2. Close the browser tab, or the whole browser.\n3. If it won't close, restart the computer.\n\nNo real warning ever asks you to call or to pay."
        }
      ]
    },
    {
      "expectPrompt": "only a cancel",
      "steps": [
        {
          "ask": {
            "toolCall": {
              "toolCallId": "change-2",
              "title": "Edit notes.txt",
              "kind": "edit",
              "locations": [
                {
                  "path": "/home/test/notes.txt"
                }
              ]
            },
            "options": [
              {
                "optionId": "yes",
                "name": "Allow",
                "kind": "allow_once"
              }
            ]
          },
          "expect": "cancelled"
        },
        {
          "say": "Understood."
        }
      ]
    },
    {
      "expectPrompt": "without asking",
      "steps": [
        {
          "tool": {
            "toolCallId": "sneaky-1",
            "title": "Edit settings.ini",
            "kind": "edit",
            "status": "in_progress"
          }
        },
        {
          "update": {
            "toolCallId": "sneaky-1",
            "status": "completed"
          }
        },
        {
          "say": "Done."
        }
      ]
    },
    {
      "expectPrompt": "take your time",
      "steps": [
        {
          "say": "Thinking about it"
        },
        {
          "waitForCancel": true
        }
      ]
    },
    {
      "expectPrompt": "crash",
      "steps": [
        {
          "say": "Oh no"
        },
        {
          "exit": 3
        }
      ]
    },
    {
      "expectPrompt": "file a request",
      "steps": [
        {
          "error": {
            "code": -32603,
            "message": "The pretend model is busy."
          }
        }
      ]
    },
    {
      "expectPrompt": "sign me out",
      "steps": [
        {
          "error": {
            "code": -32000,
            "message": "Authentication required"
          }
        }
      ]
    },
    {
      "expectPrompt": "quieter",
      "steps": [
        {
          "say": "The Quiet profile keeps the fans down."
        },
        {
          "tool": {
            "toolCallId": "propose-1",
            "title": "Propose a change",
            "kind": "execute",
            "status": "pending",
            "rawInput": {
              "command": [
                "bash",
                "-lc",
                "split-rock-change '{\"title\": \"Make the fans quieter\", \"what\": \"Sets the fan profile to Quiet.\", \"why\": \"Quiet keeps the fans down while you read.\", \"command\": \"echo quiet > \\\"$HOME/fan-profile\\\"\", \"undo\": \"rm \\\"$HOME/fan-profile\\\"\", \"check\": \"cat \\\"$HOME/fan-profile\\\"\"}'"
              ]
            }
          }
        },
        {
          "ask": {
            "toolCall": {
              "toolCallId": "propose-1"
            },
            "options": [
              {
                "optionId": "yes",
                "name": "Allow",
                "kind": "allow_once"
              },
              {
                "optionId": "no",
                "name": "Reject",
                "kind": "reject_once"
              }
            ]
          },
          "expect": "reject_once"
        },
        {
          "update": {
            "toolCallId": "propose-1",
            "status": "failed"
          }
        },
        {
          "say": "\n\nTap Do it to make it."
        }
      ]
    },
    {
      "expectPrompt": "tapped Do it",
      "steps": [
        {
          "say": "It is set to Quiet now."
        }
      ]
    },
    {
      "expectPrompt": "pointer easier to see",
      "steps": [
        {
          "say": "Altas is a clear pointer."
        },
        {
          "tool": {
            "toolCallId": "propose-2",
            "title": "Propose a change",
            "kind": "execute",
            "status": "pending",
            "rawInput": {
              "command": "split-rock-change '{\"title\": \"Set the pointer to Altas\", \"command\": \"plasma-apply-cursortheme Altas\"}'"
            }
          }
        },
        {
          "ask": {
            "toolCall": {
              "toolCallId": "propose-2"
            },
            "options": [
              {
                "optionId": "no",
                "name": "Reject",
                "kind": "reject_once"
              }
            ]
          },
          "expect": "reject_once"
        },
        {
          "update": {
            "toolCallId": "propose-2",
            "status": "failed"
          }
        }
      ]
    }
  ]
}
